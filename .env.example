# DPDP-Guard Production Environment Variables
# Copy to .env and customize before deploying.

# Application Environment (production / development)
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1
SECRET_KEY=replace_with_a_long_cryptographically_secure_random_key_in_production_991823

# Database URL (SQLite default or PostgreSQL for enterprise clustering)
DATABASE_URL=sqlite+aiosqlite:///./dpdp_guard.db

# CORS Configuration (comma-separated origins permitted to communicate with API)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Scanner Scope & SSRF Security
MAX_SCAN_CONCURRENCY=3
ALLOWED_LOCAL_DOMAINS=paysecure-india.in,apollo-telemed.co.in,retail-bharat.store,localhost,127.0.0.1,demo.dpdpguard.in

# Investigation Copilot LLM Provider (demo / openai / anthropic / gemini)
COPILOT_PROVIDER=demo
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Egress Proxy Configuration (Optional dedicated forward proxy)
EGRESS_PROXY_ENABLED=false
EGRESS_PROXY_URL=
EGRESS_PROXY_TOKEN=
